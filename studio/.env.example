# OpenVideoStudio — environment variables template.
# Copy this file to .env and fill in real values. .env itself is gitignored
# and must never be committed.

# Required for the default local providers: the ComfyUI/ directory itself
# (the one containing input/ and output/), e.g.
# C:\ComfyUI_windows_portable\ComfyUI or /home/you/ComfyUI_windows_portable/ComfyUI
COMFYUI_ROOT=

# Optional — Media Remix "Search online" music sources. Openverse and
# Internet Archive need no key. Jamendo needs a free client id from
# https://devportal.jamendo.com (non-commercial use per its API terms).
# JAMENDO_CLIENT_ID=
# OPENVERSE_API_KEY=

# Everything below is only required if you switch [providers] in
# config.toml to a cloud LLM/image/video provider.

# DeepSeek (future provider)
# DEEPSEEK_API_KEY=

# Anthropic Claude (future provider)
# ANTHROPIC_API_KEY=

# OpenAI (future provider)
# OPENAI_API_KEY=

# Google Gemini (future provider)
# GEMINI_API_KEY=

# xAI Grok (future provider)
# GROK_API_KEY=
